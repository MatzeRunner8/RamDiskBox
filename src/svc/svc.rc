#include <winver.h>
#include "../common/version.h"

1 ICON "../gui/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RDB_VERSION_RC
 PRODUCTVERSION RDB_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "CompanyName", "justbox"
            VALUE "FileDescription", "RamDiskBox Dienst"
            VALUE "FileVersion", RDB_VERSION_RCSTR
            VALUE "InternalName", "RamDiskBoxSvc"
            VALUE "LegalCopyright", "justbox"
            VALUE "OriginalFilename", "RamDiskBoxSvc.exe"
            VALUE "ProductName", "RamDiskBox"
            VALUE "ProductVersion", RDB_VERSION_RCSTR
        END
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "justbox"
            VALUE "FileDescription", "RamDiskBox Service"
            VALUE "FileVersion", RDB_VERSION_RCSTR
            VALUE "InternalName", "RamDiskBoxSvc"
            VALUE "LegalCopyright", "justbox"
            VALUE "OriginalFilename", "RamDiskBoxSvc.exe"
            VALUE "ProductName", "RamDiskBox"
            VALUE "ProductVersion", RDB_VERSION_RCSTR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200, 0x409, 1200
    END
END
