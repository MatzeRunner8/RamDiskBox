#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "setup_res.h"
#include "../common/version.h"

IDI_APP ICON "../gui/app.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "setup.manifest"

// Programmdateien aus dem frischen Build (build.bat baut das Setup zuletzt)
IDR_FILE_GUI        RCDATA "../../build/bin/RamDiskBox.exe"
IDR_FILE_SVC        RCDATA "../../build/bin/RamDiskBoxSvc.exe"
IDR_FILE_CTL        RCDATA "../../build/bin/rdbctl.exe"
IDR_FILE_LIESMICH   RCDATA "../../README.de.md"
IDR_FILE_README     RCDATA "../../README.md"
IDR_FILE_LICENSE    RCDATA "../../LICENSE"
IDR_FILE_LIC_LZ4    RCDATA "../third_party/lz4/LICENSE"
IDR_FILE_LIC_ZSTD   RCDATA "../third_party/zstd/LICENSE"

// Texte werden zur Laufzeit in der Sprache von Windows gesetzt.
IDD_SETUP DIALOGEX 0, 0, 320, 246
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "RamDiskBox Setup"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_LOGO, "Static", SS_ICON | SS_REALSIZECONTROL, 10, 10, 24, 24
    LTEXT           "", IDC_TITLE, 42, 10, 270, 12
    LTEXT           "", IDC_INTRO, 42, 24, 270, 26
    GROUPBOX        "", IDC_G_TYPE, 7, 54, 306, 72
    AUTORADIOBUTTON "", IDC_ALLUSERS, 15, 67, 290, 10, WS_GROUP | WS_TABSTOP
    LTEXT           "", IDC_ALLUSERS_HINT, 27, 78, 280, 16
    AUTORADIOBUTTON "", IDC_JUSTME, 15, 96, 290, 10
    LTEXT           "", IDC_JUSTME_HINT, 27, 107, 280, 16
    LTEXT           "", IDC_L_DIR, 7, 133, 300, 8
    EDITTEXT        IDC_DIR, 7, 143, 282, 13, ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "…", IDC_BROWSE, 292, 142, 21, 15
    AUTOCHECKBOX    "", IDC_STARTMENU, 7, 164, 300, 10
    AUTOCHECKBOX    "", IDC_DESKTOP, 7, 177, 300, 10
    AUTOCHECKBOX    "", IDC_AUTOSTART, 7, 190, 300, 10
    AUTOCHECKBOX    "", IDC_LAUNCH, 7, 203, 300, 10
    LTEXT           "", IDC_STATUS, 7, 222, 172, 18
    DEFPUSHBUTTON   "", IDOK, 184, 224, 70, 15
    PUSHBUTTON      "", IDCANCEL, 258, 224, 55, 15
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RDB_VERSION_RC
 PRODUCTVERSION RDB_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "CompanyName", "justbox"
            VALUE "FileDescription", "RamDiskBox Setup"
            VALUE "FileVersion", RDB_VERSION_RCSTR
            VALUE "InternalName", "RamDiskBox-Setup"
            VALUE "LegalCopyright", "justbox"
            VALUE "OriginalFilename", "RamDiskBox-Setup.exe"
            VALUE "ProductName", "RamDiskBox"
            VALUE "ProductVersion", RDB_VERSION_RCSTR
        END
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "justbox"
            VALUE "FileDescription", "RamDiskBox Setup"
            VALUE "FileVersion", RDB_VERSION_RCSTR
            VALUE "InternalName", "RamDiskBox-Setup"
            VALUE "LegalCopyright", "justbox"
            VALUE "OriginalFilename", "RamDiskBox-Setup.exe"
            VALUE "ProductName", "RamDiskBox"
            VALUE "ProductVersion", RDB_VERSION_RCSTR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200, 0x409, 1200
    END
END
